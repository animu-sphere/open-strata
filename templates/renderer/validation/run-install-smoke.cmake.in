if(NOT DEFINED BUILD_DIR OR NOT DEFINED PREFIX)
  message(FATAL_ERROR "BUILD_DIR and PREFIX are required")
endif()

file(REMOVE_RECURSE "${PREFIX}")
execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "${BUILD_DIR}"
    --config "${CONFIG}" --prefix "${PREFIX}"
  RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "renderer install failed: ${install_result}")
endif()

set(headless "${PREFIX}/@CMAKE_INSTALL_BINDIR@/{{name}}-headless@CMAKE_EXECUTABLE_SUFFIX@")
if(NOT EXISTS "${headless}")
  message(FATAL_ERROR "installed headless product is missing: ${headless}")
endif()
execute_process(
  COMMAND "${headless}" --install-tree
    --report "${PREFIX}/renderer-install-report.json"
  RESULT_VARIABLE smoke_result)
if(NOT smoke_result EQUAL 0)
  message(FATAL_ERROR "installed headless smoke failed: ${smoke_result}")
endif()

# Validation consumes the primary build-tree report, not reports nested in the
# install prefix. Publish only the assertion exercised here, preserving GPU and
# Hydra checks. RUN_SERIAL prevents another CTest from writing it concurrently.
set(renderer_report "${BUILD_DIR}/renderer-report.json")
file(READ "${renderer_report}" report_json)
file(READ "${PREFIX}/renderer-install-report.json" install_json)
string(JSON install_count LENGTH "${install_json}" checks)
math(EXPR install_last "${install_count} - 1")
set(install_check "")
foreach(index RANGE 0 ${install_last})
  string(JSON check_id GET "${install_json}" checks ${index} id)
  if(check_id STREQUAL "renderer.install_tree")
    string(JSON install_check GET "${install_json}" checks ${index})
    string(JSON install_status GET "${install_check}" status)
    if(NOT install_status STREQUAL "pass")
      message(FATAL_ERROR "installed headless report did not pass renderer.install_tree")
    endif()
  endif()
endforeach()
if(install_check STREQUAL "")
  message(FATAL_ERROR "installed headless report is missing renderer.install_tree")
endif()
string(JSON check_count LENGTH "${report_json}" checks)
math(EXPR check_last "${check_count} - 1")
set(merged FALSE)
foreach(index RANGE 0 ${check_last})
  string(JSON check_id GET "${report_json}" checks ${index} id)
  if(check_id STREQUAL "renderer.install_tree")
    string(JSON report_json SET "${report_json}" checks ${index} "${install_check}")
    set(merged TRUE)
  endif()
endforeach()
if(NOT merged)
  message(FATAL_ERROR "base renderer report is missing renderer.install_tree")
endif()
file(WRITE "${renderer_report}" "${report_json}\n")
