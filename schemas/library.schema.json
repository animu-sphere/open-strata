{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/animu-sphere/open-strata/main/schemas/library.schema.json",
  "title": "OpenStrata Plain Library Manifest",
  "description": "The openstrata.library.yaml descriptor for an ordinary installed CMake package participating in a source workspace closure.",
  "type": "object",
  "required": ["schema", "library", "cmake"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "openstrata.library/v1alpha1" },
    "library": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        }
      }
    },
    "cmake": {
      "type": "object",
      "required": ["package", "target"],
      "additionalProperties": false,
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "pattern": "^[^:]+(::[^:]+)+$" }
      }
    },
    "package": {
      "type": "object",
      "required": ["standalone", "aggregate_member"],
      "additionalProperties": false,
      "properties": {
        "standalone": { "type": "boolean" },
        "aggregate_member": { "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "standalone": { "const": true } } },
        { "properties": { "aggregate_member": { "const": true } } }
      ]
    },
    "package_contract": {
      "type": "object",
      "required": ["package_name", "exported_targets"],
      "additionalProperties": false,
      "properties": {
        "package_name": { "type": "string", "minLength": 1 },
        "exported_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^:]+(::[^:]+)+$" }
        },
        "public_headers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "type": "string", "minLength": 1 },
            "symbol": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          },
          "dependencies": { "symbol": ["include"] }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "libraries": {
          "type": "array",
          "items": { "$ref": "#/definitions/libraryDependency" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": {
          "type": "array",
          "default": ["bin", "lib"],
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "dependencies": {
    "package_contract": ["package"]
  },
  "definitions": {
    "libraryDependency": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
