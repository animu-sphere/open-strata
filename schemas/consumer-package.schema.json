{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstrata.dev/schemas/consumer-package.schema.json",
  "title": "OpenStrata Consumer Package Manifest",
  "description": "Registry-neutral contract for a native SDK, Python wheel, or npm distribution derived from one digest-pinned composed-runtime artifact. Public ecosystem entrypoints stay separate from the package-private OST loader protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package", "runtime", "public_api", "private_loader"],
  "properties": {
    "schema": { "const": "openstrata.consumer-package/v1alpha1" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "enum": ["native-sdk", "python-wheel", "npm-javascript", "npm-wasm"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_digest", "runtime_digest", "sbom_digest", "provenance_digest", "target", "components"],
      "properties": {
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "runtime_digest": { "$ref": "#/$defs/digest" },
        "sbom_digest": { "$ref": "#/$defs/digest" },
        "provenance_digest": { "$ref": "#/$defs/digest" },
        "target": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "digest"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" },
              "sbom_digest": { "$ref": "#/$defs/digest" },
              "provenance_digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "public_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoints"],
      "properties": {
        "entrypoints": {
          "description": "CMake package names, Python import modules, or JavaScript export keys interpreted according to package.kind.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "private_loader": {
      "description": "Package implementation contract. Consumers use public_api and do not parse OST metadata directly.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "strategy", "artifact_kind", "sdk_schema"],
      "properties": {
        "scope": { "const": "package-private" },
        "strategy": { "const": "verify-extract-activate" },
        "artifact_kind": { "const": "openstrata.composed-runtime" },
        "sdk_schema": { "const": "openstrata.runtime-sdk/v1alpha1" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "package": { "properties": { "kind": { "const": "native-sdk" } } }
        }
      },
      "then": {
        "properties": {
          "public_api": {
            "properties": {
              "entrypoints": {
                "items": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]*$" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "package": { "properties": { "kind": { "const": "python-wheel" } } }
        }
      },
      "then": {
        "properties": {
          "public_api": {
            "properties": {
              "entrypoints": {
                "items": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "package": {
            "properties": {
              "kind": { "enum": ["npm-javascript", "npm-wasm"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "public_api": {
            "properties": {
              "entrypoints": {
                "items": {
                  "pattern": "^(?!.*\\s$)(?:\\.|\\./(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000\\r\\n]+)*)$"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
