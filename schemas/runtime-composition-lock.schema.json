{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstrata.dev/schemas/runtime-composition-lock.schema.json",
  "title": "OpenStrata Runtime Composition Lock",
  "description": "Portable provider, source, compatibility, dependency and materialized-inventory lock. Semantic validation re-resolves the locked contracts and recomputes runtime identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest", "resolved", "artifacts", "dependencies", "inventory", "runtime_digest"],
  "properties": {
    "schema": { "const": "openstrata.runtime-composition-lock/v1alpha1" },
    "manifest": { "$ref": "runtime-composition.schema.json" },
    "resolved": {
      "type": "object",
      "required": ["schema", "name", "target", "manifest_digest", "composition_digest", "components", "providers", "environment", "install", "conflicts"],
      "properties": {
        "schema": { "const": "openstrata.runtime-composition-resolved/v1alpha1" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "composition_digest": { "$ref": "#/$defs/digest" },
        "conflicts": { "type": "array", "maxItems": 0 }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["manifest_digest", "record"],
        "properties": {
          "manifest_digest": { "$ref": "#/$defs/digest" },
          "record": {
            "type": "object",
            "required": ["schema", "kind", "name", "version", "target", "digest", "component", "created_unix", "imported_by", "source", "trust"],
            "properties": {
              "digest": { "$ref": "#/$defs/digest" },
              "component": { "$ref": "component.schema.json" },
              "created_unix": { "const": 0 },
              "imported_by": { "const": "" },
              "source": { "const": "imported" },
              "trust": { "const": "local" }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["consumer", "capability", "provider", "digest"],
        "properties": {
          "consumer": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "artifact", "file"],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "artifact": { "$ref": "#/$defs/digest" },
          "file": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": { "type": "string", "pattern": "^components/[^/]+/.+$" },
              "sha256": { "$ref": "#/$defs/digest" },
              "size": { "type": "integer", "minimum": 0 },
              "link_target": { "type": "string", "minLength": 1 },
              "executable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "sdk": { "$ref": "runtime-sdk.schema.json" },
    "runtime_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
