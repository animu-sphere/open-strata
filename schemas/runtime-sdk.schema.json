{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstrata.dev/schemas/runtime-sdk.schema.json",
  "title": "OpenStrata Runtime SDK Layout",
  "description": "Deterministic file ownership and portable Formation activation contributions, embedded in SDK composition locks and metadata/sdk.json. Semantic validation derives the entire layout again from the component contracts and inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "roots", "files", "environment"],
  "properties": {
    "schema": { "const": "openstrata.runtime-sdk/v1alpha1" },
    "roots": { "const": ["bin", "lib", "include", "share", "plugins", "python", "node", "metadata"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "artifact", "source", "file"],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "artifact": { "$ref": "#/$defs/digest" },
          "source": { "type": "string", "pattern": "^components/[^/]+/.+$" },
          "file": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/digest" },
              "size": { "type": "integer", "minimum": 0 },
              "link_target": { "type": "string", "minLength": 1 },
              "executable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["linux", "macos", "windows"],
      "properties": {
        "linux": { "$ref": "#/$defs/contributions" },
        "macos": { "$ref": "#/$defs/contributions" },
        "windows": { "$ref": "#/$defs/contributions" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "operation", "source", "paths"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "operation": { "enum": ["prepend", "append", "set"] },
          "source": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
