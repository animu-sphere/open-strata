{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/animu-sphere/open-strata/main/schemas/platform.schema.json",
  "title": "OpenStrata Platform Manifest",
  "description": "A machine-readable VFX Reference Platform calendar-year definition.",
  "type": "object",
  "required": ["id", "source", "core"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cy[0-9]{4}$",
      "description": "Calendar-year id, e.g. cy2026."
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["vfx-reference-platform", "custom"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "final", "superseded"],
          "default": "draft"
        }
      }
    },
    "core": {
      "type": "object",
      "description": "Component -> version constraint map.",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "openusd": {
      "$ref": "#/definitions/openusdPolicy"
    },
    "notes": {
      "type": "string"
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "required": ["family", "provider", "version_from"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "version_from": { "type": "string", "minLength": 1 }
      }
    },
    "variant": {
      "type": "object",
      "required": ["id", "builders", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "enum": ["headless", "standard", "vulkan"] },
        "builders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["build-usd", "cmake"] }
        },
        "build_usd_args": { "type": "array", "items": { "type": "string" } },
        "cmake_args": { "type": "array", "items": { "type": "string" } },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "openusdPolicy": {
      "type": "object",
      "required": ["schema", "cells"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": 1 },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["os", "arch", "toolchain", "python", "tbb", "variants"],
            "additionalProperties": false,
            "properties": {
              "os": { "type": "string", "enum": ["linux", "macos", "windows"] },
              "arch": { "type": "string", "enum": ["x86_64", "arm64"] },
              "toolchain": {
                "type": "object",
                "required": ["family", "provider", "version_from", "cxx_standard_from", "runtime"],
                "additionalProperties": false,
                "properties": {
                  "family": { "type": "string", "minLength": 1 },
                  "provider": { "type": "string", "minLength": 1 },
                  "version_from": { "type": "string", "minLength": 1 },
                  "cxx_standard_from": { "type": "string", "minLength": 1 },
                  "runtime": { "$ref": "#/definitions/provider" }
                }
              },
              "python": { "$ref": "#/definitions/provider" },
              "tbb": { "$ref": "#/definitions/provider" },
              "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/variant" } }
            }
          }
        }
      }
    }
  }
}
